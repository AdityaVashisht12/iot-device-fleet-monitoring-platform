# Copy to .env before starting. Rotate all local example credentials for shared environments.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=iot_telemetry
POSTGRES_USER=iot_app
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-local
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=change-me-local

MOSQUITTO_IMAGE=eclipse-mosquitto:2.0.21
MQTT_PORT=1883

KAFKA_IMAGE=apache/kafka:3.9.1
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=9092
KAFKA_TOPIC_PARTITIONS=3
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TELEMETRY_TOPIC=iot-telemetry
KAFKA_CLIENT_ID=iot-mqtt-kafka-bridge
KAFKA_DELIVERY_TIMEOUT_SECONDS=10
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_SECONDS=1
KAFKA_CONSUMER_GROUP_ID=iot-telemetry-postgres
KAFKA_CONSUMER_CLIENT_ID=iot-telemetry-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_POLL_TIMEOUT_SECONDS=1
MQTT_HOST=localhost
MQTT_INGEST_CLIENT_ID=iot-telemetry-ingestor
MQTT_KEEPALIVE=60
MQTT_INGEST_TOPIC=iot/devices/+/telemetry
MQTT_INGEST_QOS=1

IOT_APP_IMAGE=iot-telemetry-app:local
SIMULATOR_DEVICE_COUNT=500
SIMULATOR_INTERVAL_SECONDS=2
SIMULATOR_SPEED_MULTIPLIER=1
SIMULATOR_ABNORMAL_PROBABILITY=0.01
SIMULATOR_FAILURE_PROBABILITY=0.0005
SIMULATOR_MIN_FAILURE_TICKS=3
SIMULATOR_MAX_FAILURE_TICKS=15
SIMULATOR_MQTT_QOS=1
SIMULATOR_RANDOM_SEED=

AIRFLOW_IMAGE=local/iot-airflow:2.11.1
AIRFLOW_PORT=8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=change-me-local
# Valid development key only; generate a unique key with Fernet.generate_key() before deployment.
AIRFLOW_FERNET_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
AIRFLOW_SECRET_KEY=dev-only-change-this-airflow-secret-key
AIRFLOW_ALERT_EMAIL=

GRAFANA_IMAGE=grafana/grafana:13.3.0
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-local
