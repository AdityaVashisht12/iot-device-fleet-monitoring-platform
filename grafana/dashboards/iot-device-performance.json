          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (p.device_id) p.event_timestamp, d.device_id, d.region, d.operational_status, p.temperature_c, p.cpu_usage_pct, p.memory_usage_pct, p.network_latency_ms, p.packet_loss_pct, p.battery_level_pct, p.device_health_score, p.performance_status FROM processed_telemetry p JOIN devices d USING (device_id) WHERE $__timeFilter(p.event_timestamp) AND (${region:sqlstring} = 'All' OR d.region = ${region:sqlstring}) AND (${device_id:sqlstring} = 'All' OR d.device_id = ${device_id:sqlstring}) ORDER BY p.device_id, p.event_timestamp DESC",
