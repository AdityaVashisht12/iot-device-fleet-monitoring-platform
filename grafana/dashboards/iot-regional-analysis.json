          "rawSql": "SELECT d.region, COUNT(DISTINCT d.device_id) AS devices, COUNT(p.event_id) AS telemetry_events, AVG(p.device_health_score) AS avg_health_score, AVG(p.cpu_usage_pct) AS avg_cpu_pct, AVG(p.network_latency_ms) AS avg_latency_ms, COUNT(*) FILTER (WHERE p.is_anomaly) AS anomalies FROM devices d LEFT JOIN processed_telemetry p ON p.device_id = d.device_id AND p.event_timestamp >= CURRENT_TIMESTAMP - INTERVAL '24 hours' WHERE TRUE AND (${region:sqlstring} = 'All' OR d.region = ${region:sqlstring}) AND (${device_id:sqlstring} = 'All' OR d.device_id = ${device_id:sqlstring}) GROUP BY d.region ORDER BY avg_health_score DESC",
