          "rawSql": "SELECT a.alert_timestamp, a.last_seen_at, d.device_id, d.region, a.alert_type, a.severity, a.occurrence_count, a.details FROM device_alerts a JOIN devices d USING (device_id) WHERE a.resolved_at IS NULL AND a.severity = 'CRITICAL' AND (${region:sqlstring} = 'All' OR d.region = ${region:sqlstring}) AND (${device_id:sqlstring} = 'All' OR d.device_id = ${device_id:sqlstring}) ORDER BY a.last_seen_at DESC LIMIT 100",
